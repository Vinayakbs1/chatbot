# Azure Cosmos DB
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=CareerGuidanceDB
COSMOS_CONTAINER=UserPreferences

# Azure LUIS
LUIS_ENDPOINT=https://your-luis-endpoint.cognitiveservices.azure.com/
LUIS_APP_ID=your-luis-app-id
LUIS_API_KEY=your-luis-api-key

# Azure Functions
AZURE_FUNCTION_URL=https://your-function-app.azurewebsites.net

# Flask App
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key
